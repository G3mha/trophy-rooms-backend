{
  "name": "trophy-rooms-backend",
  "version": "1.0.0",
  "description": "GraphQL backend for Trophy Rooms - Nintendo Switch achievement tracking",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "generate": "prisma generate",
