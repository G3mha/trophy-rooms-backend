    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@clerk/backend": "^1.21.0",
    "@pothos/core": "^4.3.0",
    "@pothos/plugin-prisma": "^4.3.0",
