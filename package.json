{
  "name": "trophy-rooms-backend",
  "version": "1.0.0",
  "description": "GraphQL backend for Trophy Rooms - Nintendo Switch achievement tracking",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed-games.ts",
    "db:seed-platforms": "tsx scripts/seed-platforms.ts",
    "db:seed-all": "tsx scripts/seed-all-platforms.ts",
    "db:import-platform-region": "tsx scripts/import-platform-region.ts",
    "db:cleanup": "tsx scripts/cleanup-shovelware.ts",
    "db:counts": "tsx scripts/platform-counts.ts",
    "db:verify": "tsx scripts/verify-cleanup.ts",
    "db:cleanup-titles": "tsx scripts/cleanup-weird-titles.ts",
    "db:populate-achievement-icons": "tsx scripts/populate-achievement-icons.ts",
    "db:import-retroachievements-set": "tsx scripts/import-retroachievements-set.ts",
    "postinstall": "node -e \"if (!process.env.PRISMA_SKIP_POSTINSTALL_GENERATE) { require('child_process').execSync('npx prisma generate', { stdio: 'inherit' }); }\""
  },
  "dependencies": {
    "@clerk/backend": "^1.21.0",
    "@pothos/core": "^4.3.0",
    "@pothos/plugin-prisma": "^4.3.0",
    "@pothos/plugin-relay": "^4.3.0",
    "@pothos/plugin-validation": "^4.2.0",
    "@prisma/client": "^6.1.0",
    "@types/node": "^22.10.0",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.10.0",
    "ioredis": "^5.10.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
