generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "@prisma/client"
  output       = "../src/generated/pothos-types.ts"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AchievementSetType {
  OFFICIAL
  COMPLETIONIST
  CUSTOM
}

enum AchievementSetVisibility {
  PRIVATE
  PUBLIC
}

enum UserRole {
  USER
  TRUSTED
  ADMIN
}

enum AchievementTier {
  BRONZE
  SILVER
  GOLD
}

enum GameStatus {
  WISHLIST
  BACKLOG
  PLAYING
  PAUSED
  COMPLETED
  DROPPED
}

enum GameRegion {
  NTSC_U    // North America
  PAL       // Europe/Australia
  NTSC_J    // Japan
  OTHER
}

enum DLCType {
  DLC
  EXPANSION
  FREE_UPDATE
}

enum BundleType {
  BUNDLE
  SEASON_PASS
  COLLECTION
  SUBSCRIPTION
}

enum GameType {
  BASE_GAME
  FANGAME
  ROM_HACK
}

model User {
  id              String            @id @default(cuid())
  clerkId         String            @unique
  email           String            @unique
  name            String?
  role            UserRole          @default(USER)
  achievements    UserAchievement[]
  trophies        Trophy[]
  userGames       UserGame[]
  collectionItems CollectionItem[]
  achievementSets AchievementSet[] @relation("AchievementSetCreator")
  ownedDlcs       UserDLC[]
  ownedBundles    UserBundle[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([clerkId])
}

model Platform {
  id              String           @id @default(cuid())
  name            String           @unique
  slug            String           @unique
  games           Game[]
  collectionItems CollectionItem[]
  userGames       UserGame[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Game {
  id              String           @id @default(cuid())
  title           String
  description     String?
  coverUrl        String?
  releaseDate     DateTime?
  developer       String?
  publisher       String?
  genre           String?
  esrbRating      String?
  screenshots     String[]

  // Game type categorization (fangames, ROM hacks)
  type            GameType         @default(BASE_GAME)

  // Self-referencing relation for derivatives (fangames/ROM hacks based on this game)
  baseGame        Game?            @relation("GameDerivatives", fields: [baseGameId], references: [id], onDelete: SetNull)
  baseGameId      String?
  derivatives     Game[]           @relation("GameDerivatives")

  platform        Platform?        @relation(fields: [platformId], references: [id])
  platformId      String?
  achievementSets AchievementSet[]
  trophies        Trophy[]
  userGames       UserGame[]
  collectionItems CollectionItem[]
  versions        GameVersion[]
  dlcs            DLC[]
  bundles         Bundle[]         @relation("BundleGames")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([title, platformId])
  @@index([platformId])
  @@index([type])
  @@index([baseGameId])
}

model GameVersion {
  id              String           @id @default(cuid())
  name            String           // "Standard", "Deluxe Edition"
  slug            String           // "standard", "deluxe"
  description     String?
  coverUrl        String?          // Fallback to game.coverUrl if null
  releaseDate     DateTime?
  isDefault       Boolean          @default(false)

  game            Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId          String

  dlcs            DLC[]            @relation("GameVersionDLCs")
  achievementSets AchievementSet[]
  userGames       UserGame[]
  collectionItems CollectionItem[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([gameId, slug])
  @@index([gameId])
}

model AchievementSet {
  id              String             @id @default(cuid())
  title           String
  type            AchievementSetType @default(OFFICIAL)
  visibility      AchievementSetVisibility @default(PRIVATE)
  game            Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId          String
  gameVersion     GameVersion?       @relation(fields: [gameVersionId], references: [id], onDelete: SetNull)
  gameVersionId   String?
  dlc             DLC?               @relation(fields: [dlcId], references: [id], onDelete: SetNull)
  dlcId           String?
  createdBy       User?              @relation("AchievementSetCreator", fields: [createdByUserId], references: [id])
  createdByUserId String?
  achievements    Achievement[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([gameId])
  @@index([gameVersionId])
  @@index([dlcId])
  @@index([createdByUserId])
  @@unique([gameId, title, type, createdByUserId])
}

model Achievement {
  id              String            @id @default(cuid())
  title           String
  description     String?
  iconUrl         String?
  points          Int               @default(0)
  tier            AchievementTier   @default(BRONZE)
  achievementSet  AchievementSet    @relation(fields: [achievementSetId], references: [id], onDelete: Cascade)
  achievementSetId String
  users           UserAchievement[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([achievementSetId])
  @@unique([achievementSetId, title])
}

model UserAchievement {
  id            String      @id @default(cuid())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId String
  createdAt     DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model Trophy {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    String
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
}

model UserGame {
  id            String       @id @default(cuid())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  game          Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId        String
  platform      Platform?    @relation(fields: [platformId], references: [id])
  platformId    String?
  gameVersion   GameVersion? @relation(fields: [gameVersionId], references: [id], onDelete: SetNull)
  gameVersionId String?
  status        GameStatus
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
  @@index([platformId])
  @@index([gameVersionId])
  @@index([userId, status])
}

model CollectionItem {
  id            String       @id @default(cuid())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  game          Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId        String
  platform      Platform?    @relation(fields: [platformId], references: [id])
  platformId    String?
  gameVersion   GameVersion? @relation(fields: [gameVersionId], references: [id], onDelete: SetNull)
  gameVersionId String?

  // Physical components
  hasDisc   Boolean    @default(false)
  hasBox    Boolean    @default(false)
  hasManual Boolean    @default(false)
  hasExtras Boolean    @default(false)

  // Status
  isSealed  Boolean    @default(false)
  region    GameRegion @default(NTSC_U)
  notes     String?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([gameId])
  @@index([gameVersionId])
  @@index([userId, gameId])
}

model DLC {
  id              String           @id @default(cuid())
  name            String           // "Shadow of the Erdtree"
  slug            String           // "shadow-of-the-erdtree"
  type            DLCType          @default(DLC)
  description     String?
  coverUrl        String?          // Fallback to game.coverUrl if null
  releaseDate     DateTime?
  price           Float?           // null for free updates

  game            Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId          String

  achievementSets AchievementSet[]
  gameVersions    GameVersion[]    @relation("GameVersionDLCs")
  bundles         Bundle[]         @relation("BundleDLCs")
  userDlcs        UserDLC[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([gameId, slug])
  @@index([gameId])
}

model UserDLC {
  id        String   @id @default(cuid())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  dlc       DLC      @relation(fields: [dlcId], references: [id], onDelete: Cascade)
  dlcId     String

  ownedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dlcId])
  @@index([userId])
  @@index([dlcId])
}

model Bundle {
  id              String           @id @default(cuid())
  name            String           // "Elden Ring + Shadow of the Erdtree Bundle"
  slug            String           @unique
  type            BundleType       @default(BUNDLE)
  description     String?
  coverUrl        String?
  releaseDate     DateTime?
  price           Float?

  // Many-to-many with games and DLCs
  games           Game[]           @relation("BundleGames")
  dlcs            DLC[]            @relation("BundleDLCs")
  userBundles     UserBundle[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([type])
}

model UserBundle {
  id        String   @id @default(cuid())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  bundle    Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  bundleId  String

  ownedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bundleId])
  @@index([userId])
  @@index([bundleId])
}
