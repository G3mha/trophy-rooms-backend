generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "@prisma/client"
  output       = "../src/generated/pothos-types.ts"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AchievementSetType {
  OFFICIAL
  COMPLETIONIST
  CUSTOM
}

enum AchievementSetVisibility {
  PRIVATE
  PUBLIC
}

enum UserRole {
  USER
  TRUSTED
  ADMIN
}

enum AchievementTier {
  BRONZE
  SILVER
  GOLD
}

enum GameStatus {
  BACKLOG
  PLAYING
  PAUSED
  COMPLETED
  DROPPED
}

enum GameRegion {
  NTSC_U // North America
  PAL // Europe/Australia
  NTSC_J // Japan
  OTHER
}

enum DLCType {
  DLC
  EXPANSION
  FREE_UPDATE
}

enum BundleType {
  BUNDLE
  SEASON_PASS
  COLLECTION
  SUBSCRIPTION
}

enum GameType {
  BASE_GAME
  FANGAME
  ROM_HACK
  MOD
  DLC
  EXPANSION
}

enum BuylistPriority {
  HIGH
  MEDIUM
  LOW
}

model User {
  id              String            @id @default(cuid())
  clerkId         String            @unique
  email           String            @unique
  name            String?
  role            UserRole          @default(USER)
  achievements    UserAchievement[]
  trophies        Trophy[]
  userGames       UserGame[]
  collectionItems CollectionItem[]
  achievementSets AchievementSet[]  @relation("AchievementSetCreator")
  ownedDlcs       UserDLC[]
  ownedBundles    UserBundle[]
  buylistItems    BuylistItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([clerkId])
}

model Platform {
  id                  String            @id @default(cuid())
  name                String            @unique
  slug                String            @unique
  description         String?
  consolePictureUrl   String?
  promotionalPictures String[]

  // Relations
  games               Game[]
  bundles             Bundle[]
  dlcs                DLC[]             @relation("DLCPlatforms")
  collectionItems     CollectionItem[]
  userGames           UserGame[]
  userBundles         UserBundle[]
  releases            PlatformRelease[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model PlatformRelease {
  id          String   @id @default(cuid())
  platform    Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  platformId  String
  region      String   // "NA", "EU", "JP", "AU", "OTHER"
  releaseDate DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([platformId, region])
  @@index([platformId])
}

model GameFamily {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  coverUrl    String?
  developer   String?
  publisher   String?
  genre       String?
  esrbRating  String?
  screenshots String[]
  releaseDate DateTime?
  type        GameType  @default(BASE_GAME)

  // Self-referencing for derivatives (fangames, ROM hacks based on other games)
  baseGameFamilies    GameFamily[] @relation("GameFamilyBaseGames")
  derivedGameFamilies GameFamily[] @relation("GameFamilyBaseGames")

  // Relations
  games           Game[]
  achievementSets AchievementSet[]
  dlcs            DLC[]
  bundles         Bundle[]         @relation("BundleGameFamilies")
  buylistItems    BuylistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model Game {
  id String @id @default(cuid())

  // Link to GameFamily (canonical game metadata)
  gameFamily   GameFamily? @relation(fields: [gameFamilyId], references: [id], onDelete: Cascade)
  gameFamilyId String? // Nullable during migration, will be required after

  platform    Platform? @relation(fields: [platformId], references: [id])
  platformId  String?
  releaseDate DateTime? // Platform-specific release date
  coverUrl    String? // Platform-specific cover override

  trophies        Trophy[]
  userGames       UserGame[]
  collectionItems CollectionItem[]
  versions        GameVersion[]    @relation("GameVersionGames")
  buylistItems    BuylistItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([gameFamilyId, platformId])
  @@index([platformId])
  @@index([gameFamilyId])
}

model GameVersion {
  id          String    @id @default(cuid())
  name        String // "Standard", "Deluxe Edition"
  slug        String    @unique // "standard", "deluxe" - now globally unique
  description String?
  coverUrl    String? // Fallback to first game's coverUrl if null
  releaseDate DateTime?
  isDefault   Boolean   @default(false)
  digitalOnly Boolean   @default(false) // If true, only digital copies can be added to collection

  games Game[] @relation("GameVersionGames")

  dlcs            DLC[]            @relation("GameVersionDLCs")
  achievementSets AchievementSet[]
  userGames       UserGame[]
  collectionItems CollectionItem[]
  buylistItems    BuylistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AchievementSet {
  id         String                   @id @default(cuid())
  title      String
  type       AchievementSetType       @default(OFFICIAL)
  visibility AchievementSetVisibility @default(PRIVATE)

  // Link to GameFamily (achievements are shared across platforms)
  gameFamily   GameFamily? @relation(fields: [gameFamilyId], references: [id], onDelete: Cascade)
  gameFamilyId String? // Nullable during migration, will be required after

  gameVersion     GameVersion?  @relation(fields: [gameVersionId], references: [id], onDelete: SetNull)
  gameVersionId   String?
  dlc             DLC?          @relation(fields: [dlcId], references: [id], onDelete: SetNull)
  dlcId           String?
  createdBy       User?         @relation("AchievementSetCreator", fields: [createdByUserId], references: [id])
  createdByUserId String?
  achievements    Achievement[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([gameFamilyId, title, type, createdByUserId])
  @@index([gameFamilyId])
  @@index([gameVersionId])
  @@index([dlcId])
  @@index([createdByUserId])
}

model Achievement {
  id               String            @id @default(cuid())
  title            String
  description      String?
  iconUrl          String?
  points           Int               @default(0)
  tier             AchievementTier   @default(BRONZE)
  achievementSet   AchievementSet    @relation(fields: [achievementSetId], references: [id], onDelete: Cascade)
  achievementSetId String
  users            UserAchievement[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([achievementSetId, title])
  @@index([achievementSetId])
}

model UserAchievement {
  id            String      @id @default(cuid())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId String
  createdAt     DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model Trophy {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    String
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
}

model UserGame {
  id            String       @id @default(cuid())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  game          Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId        String
  platform      Platform?    @relation(fields: [platformId], references: [id])
  platformId    String?
  gameVersion   GameVersion? @relation(fields: [gameVersionId], references: [id], onDelete: SetNull)
  gameVersionId String?
  status        GameStatus
  purchasePrice Float? // Actual purchase price
  purchasedAt   DateTime? // When the item was purchased
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
  @@index([platformId])
  @@index([gameVersionId])
  @@index([userId, status])
}

model CollectionItem {
  id            String       @id @default(cuid())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  game          Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId        String
  platform      Platform?    @relation(fields: [platformId], references: [id])
  platformId    String?
  gameVersion   GameVersion? @relation(fields: [gameVersionId], references: [id], onDelete: SetNull)
  gameVersionId String?

  // Physical components
  hasDisc   Boolean @default(false)
  hasBox    Boolean @default(false)
  hasManual Boolean @default(false)
  hasExtras Boolean @default(false)

  // Status
  isDigital Boolean    @default(false) // Digital copy (no physical components)
  isSealed  Boolean    @default(false)
  region    GameRegion @default(NTSC_U)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([gameId])
  @@index([gameVersionId])
  @@index([userId, gameId])
}

model DLC {
  id          String    @id @default(cuid())
  name        String // "Shadow of the Erdtree"
  slug        String // "shadow-of-the-erdtree"
  type        DLCType   @default(DLC)
  description String?
  coverUrl    String? // Fallback to gameFamily.coverUrl if null
  releaseDate DateTime?
  price       Float? // null for free updates

  // Link to GameFamily (DLCs are shared across platforms)
  gameFamily   GameFamily? @relation(fields: [gameFamilyId], references: [id], onDelete: Cascade)
  gameFamilyId String? // Nullable during migration, will be required after

  // Platforms this DLC is available on
  platforms Platform[] @relation("DLCPlatforms")

  achievementSets AchievementSet[]
  gameVersions    GameVersion[]    @relation("GameVersionDLCs")
  bundles         Bundle[]         @relation("BundleDLCs")
  userDlcs        UserDLC[]
  buylistItems    BuylistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameFamilyId, slug])
  @@index([gameFamilyId])
}

model UserDLC {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  dlc   DLC    @relation(fields: [dlcId], references: [id], onDelete: Cascade)
  dlcId String

  purchasePrice Float? // Actual purchase price
  purchasedAt   DateTime? // When the item was purchased

  ownedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dlcId])
  @@index([userId])
  @@index([dlcId])
}

model Bundle {
  id          String     @id @default(cuid())
  name        String // "Elden Ring + Shadow of the Erdtree Bundle"
  slug        String     @unique
  type        BundleType @default(BUNDLE)
  description String?
  coverUrl    String?
  releaseDate DateTime?
  price       Float?

  // Platform association
  platform   Platform? @relation(fields: [platformId], references: [id])
  platformId String?

  // Many-to-many with game families and DLCs
  gameFamilies GameFamily[]  @relation("BundleGameFamilies")
  dlcs         DLC[]         @relation("BundleDLCs")
  userBundles  UserBundle[]
  buylistItems BuylistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([platformId])
}

model UserBundle {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  bundle   Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  bundleId String

  platform   Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)
  platformId String?

  purchasePrice Float? // Actual purchase price
  purchasedAt   DateTime? // When the item was purchased

  ownedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bundleId, platformId])
  @@index([userId])
  @@index([bundleId])
  @@index([platformId])
}

model BuylistItem {
  id     String @id @default(cuid())
  userId String

  // Item type - one of these must be set
  gameFamilyId  String? // For game family (any platform)
  gameId        String? // For specific platform game
  gameVersionId String? // Specific edition (Standard, Deluxe, etc.)
  dlcId         String? // Standalone DLC
  bundleId      String? // Bundle/Season Pass

  // Metadata
  priority       BuylistPriority @default(MEDIUM)
  notes          String? // Gift notes, links, etc.
  estimatedPrice Float? // Expected price in user's currency

  // Timestamps
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameFamily  GameFamily?  @relation(fields: [gameFamilyId], references: [id], onDelete: Cascade)
  game        Game?        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameVersion GameVersion? @relation(fields: [gameVersionId], references: [id], onDelete: SetNull)
  dlc         DLC?         @relation(fields: [dlcId], references: [id], onDelete: Cascade)
  bundle      Bundle?      @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([userId, gameFamilyId, gameId, gameVersionId, dlcId, bundleId])
  @@index([userId])
}
