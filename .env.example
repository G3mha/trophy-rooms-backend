# Database (Supabase PostgreSQL)
# Use the pooled connection for queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use direct connection for migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Authentication
# Project URL - src/lib/supabase.ts falls back to a hardcoded project URL when unset
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# Service role key - required to delete users via the Supabase Auth admin API
SUPABASE_SECRET_KEY="your_supabase_service_role_key"

# Server Configuration
PORT=4000
NODE_ENV=development
# pino log level: trace|debug|info|warn|error|fatal
# (defaults to debug outside production, info in production)
LOG_LEVEL=debug
# Node runtime flags for the deployed service, e.g. heap tuning
# NODE_OPTIONS="--max-old-space-size=512"

# CORS - Frontend URLs (comma-separated for multiple)
FRONTEND_URL="http://localhost:3000"

# Redis Cache (optional - caching is disabled when unset)
REDIS_URL="redis://localhost:6379"

# IGDB API (Twitch Developer Credentials)
# Get these from https://dev.twitch.tv/console
TWITCH_CLIENT_ID="your_twitch_client_id"
TWITCH_CLIENT_SECRET="your_twitch_client_secret"

# RetroAchievements Web API (achievement import scripts only, not used by the server)
# Get yours from https://retroachievements.org/settings
# RA_WEB_API_KEY is accepted as a legacy alias for the same key
RETROACHIEVEMENTS_API_KEY="your_retroachievements_web_api_key"

# Sign in with Apple (scripts/generate-apple-secret.ts only, not used by the server)
# Mints the OAuth client secret pasted into Supabase > Auth > Apple provider
APPLE_SIWA_KEY_PATH="./secrets/AuthKey_XXXXXXXXXX.p8"
APPLE_SIWA_KEY_ID="your_apple_key_id"
APPLE_TEAM_ID="your_apple_team_id"
APPLE_SERVICE_ID="org.example.app.service"

# Build (set inline by the Dockerfile, not needed for local development)
# Skips the `prisma generate` postinstall hook during `npm ci`
# PRISMA_SKIP_POSTINSTALL_GENERATE=1
